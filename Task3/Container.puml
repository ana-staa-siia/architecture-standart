@startuml Container_Diagram
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров - MVP онлайн-открытия депозитов

Person(клиент, "Клиент", "Открывает депозит через онлайн-каналы")
Person(сотрудник_бэкофиса, "Сотрудник бэк-офиса", "Обрабатывает заявки в MVP")
Person(оператор_колцентра, "Оператор кол-центра", "Обрабатывает заявки с сайта")

System_Boundary(мвп_система, "MVP онлайн-открытия депозитов") {
    Container(сайт, "Сайт", "PHP, React.js", "Публичный каталог депозитов, заявки")
    Container(интернет_банк, "Интернет-банк", "ASP.NET MVC 4.5", "Персонализированные предложения, СМС-подтверждение")
    Container(портал_бэкофиса, "Портал бэк-офиса", "Java Spring Boot", "Обработка заявок сотрудниками")
    Container(сервис_депозитов, "Сервис депозитов", "Java Spring Boot", "Управление депозитами, заявками, кэширование")
    Container(сервис_аутентификации, "Сервис аутентификации", "Java Spring Boot", "СМС-коды подтверждения")
    ContainerDb(бд_заявок, "База данных заявок", "MS SQL", "Хранит заявки и статусы")
    Container(брокер_сообщений, "Брокер сообщений", "Apache Kafka", "Message Broker")
    Container(адаптер_абс, "Адаптер АБС", "Java", "Преобразование команд для АБС")
}

' Внешние системы
System_Ext(абс, "АБС банка",  "Основная банковская система") {
    ContainerDb(бд_абс, "База данных", "Oracle", "Финансовые операции")
    Container(клиент_абс, "Десктопный клиент", "Delphi", "UI для сотрудников")
}

System_Ext(crm_колцентра, "CRM кол-центра", "Обработка обращений")
System_Ext(смс_шлюз, "СМС-шлюз", "Отправка СМС")

' Основные взаимодействия
Rel(клиент, сайт, "Подает заявку", "HTTPS")
Rel(клиент, интернет_банк, "Открывает депозит с СМС", "HTTPS")

Rel(сайт, сервис_депозитов, "Передает заявку", "REST/HTTPS")
Rel(интернет_банк, сервис_депозитов, "Запрашивает депозиты", "REST/HTTPS")
Rel(интернет_банк, сервис_аутентификации, "Запрашивает СМС-код", "REST/HTTPS")

Rel(сервис_депозитов, бд_заявок, "Чтение/запись заявок", "JDBC")
Rel(сервис_депозитов, брокер_сообщений, "Публикует события", "Kafka")

Rel(брокер_сообщений, crm_колцентра, "Передает заявки", "Kafka")
Rel(брокер_сообщений, адаптер_абс, "Передает команды", "Kafka")

Rel(адаптер_абс, абс, "Создает депозиты", "DB API")
Rel(абс, адаптер_абс, "Уведомляет об открытии", "DB Trigger")

Rel(сервис_аутентификации, смс_шлюз, "Отправляет СМС", "REST")

Rel(сотрудник_бэкофиса, портал_бэкофиса, "Обрабатывает заявки", "HTTPS")
Rel(портал_бэкофиса, сервис_депозитов, "Работает с заявками", "REST/HTTPS")
Rel(оператор_колцентра, crm_колцентра, "Обрабатывает заявки", "HTTPS")

@enduml