@startuml Context_Diagram
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Системный контекст - MVP онлайн-открытия депозитов

Person(клиент, "Клиент", "Физическое лицо, открывающее депозит через онлайн-каналы")
Person(сотрудник_бэкофиса, "Сотрудник бэк-офиса", "Обрабатывает заявки на депозиты в MVP")
Person(оператор_колцентра, "Оператор кол-центра", "Обрабатывает заявки с сайта, консультирует клиентов")

System(мвп_депозиты, "MVP онлайн-открытия депозитов", "Предоставляет возможность онлайн-открытия депозитов через сайт и интернет-банк")

System_Ext(абс, "АБС банка", "Автоматизированная банковская система для учета операций")
System_Ext(crm_колцентра, "CRM кол-центра", "Система обработки обращений кол-центра")
System_Ext(смс_сервис, "СМС-сервис", "Внешний сервис телеком-оператора для отправки СМС")

' Взаимодействия
Rel(клиент, мвп_депозиты, "Подает заявку на депозит", "HTTPS")
Rel(оператор_колцентра, мвп_депозиты, "Обрабатывает онлайн-заявки", "HTTPS")
Rel(сотрудник_бэкофиса, мвп_депозиты, "Обрабатывает и подтверждает заявки", "HTTPS")

Rel(мвп_депозиты, crm_колцентра, "Передает заявки для обработки", "Kafka/REST")
Rel(мвп_депозиты, абс, "Создает депозитные договоры", "Kafka/DB")
Rel(мвп_депозиты, смс_сервис, "Отправляет коды подтверждения и уведомления", "REST")

@enduml