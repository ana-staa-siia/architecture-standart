```plantuml
@startuml Context_Rates
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Контекст - Передача ставок в кол-центры

Person(клиент, "Клиент", "Уточняет условия по депозитам по телефону")
Person(администратор, "Администратор ставок", "Управляет ставками по депозитам")

System(сервис_ставок, "Сервис управления ставками", "Хранение и распространение актуальных ставок")

System_Ext(внутренний_колцентр, "Внутренний кол-центр", "Обработка звонков, консультации")
System_Ext(партнерский_колцентр, "Партнерский кол-центр", "Внешняя система обработки звонков")

Rel(клиент, внутренний_колцентр, "Звонит с вопросами", "Телефония")
Rel(клиент, партнерский_колцентр, "Звонит с вопросами", "Телефония")

Rel(внутренний_колцентр, сервис_ставок, "Запрашивает актуальные ставки", "REST API")
Rel(партнерский_колцентр, сервис_ставок, "Получает файлы со ставками", "SFTP")

Rel(администратор, сервис_ставок, "Обновляет ставки", "Web UI")

@enduml
