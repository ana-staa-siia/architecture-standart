@startuml Container_Rates
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Контейнеры - Передача ставок в кол-центры

Person(клиент, "Клиент", "Уточняет условия по телефону")
Person(администратор, "Администратор ставок", "Управляет ставками")

System_Boundary(сервис_ставок, "Сервис управления ставками") {
    Container(api_ставок, "API ставок", "Java Spring Boot", "REST API", "Предоставление ставок по запросу")
    Container(менеджер_файлов, "Менеджер файлов", "Java", "Фоновый сервис", "Генерация и выгрузка файлов")
    ContainerDb(бд_ставок, "База ставок", "MS SQL", "Хранение ставок и истории")
    Container(веб_интерфейс, "Веб-интерфейс", "React", "UI", "Управление ставками")
}

System_Ext(crm_внутренний, "CRM внутреннего кол-центра", "Java, PostgreSQL", "С кэшем ставок")
System_Ext(система_партнера, "Система партнерского кол-центра", "Внешняя система", "Импорт из файлов")

' Взаимодействия
Rel(администратор, веб_интерфейс, "Обновляет ставки", "HTTPS")
Rel(веб_интерфейс, api_ставок, "Сохраняет изменения", "REST")
Rel(api_ставок, бд_ставок, "Чтение/запись", "JDBC")

Rel(crm_внутренний, api_ставок, "Запрашивает актуальные ставки", "REST/HTTPS")
Rel(api_ставок, crm_внутренний, "Уведомляет об изменениях", "Webhook/Kafka")

Rel(менеджер_файлов, бд_ставок, "Чтение ставок", "JDBC")
Rel(менеджер_файлов, система_партнера, "Выгружает файлы по расписанию", "SFTP")

Rel(клиент, crm_внутренний, "Консультируется", "Оператор")
Rel(клиент, система_партнера, "Консультируется", "Оператор")

@enduml